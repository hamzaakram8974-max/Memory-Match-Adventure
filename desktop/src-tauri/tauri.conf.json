{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Match Adventure",
  "version": "1.0.0",
  "identifier": "com.memorymatch.adventure",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run prepare:frontend",
    "beforeBuildCommand": "npm run prepare:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Memory Match Adventure",
        "url": "memory%20match%20copy.html",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "licenseFile": "../INSTALL-AGREEMENT.txt",
    "shortDescription": "A colorful local memory matching game",
    "longDescription": "Play Memory Match Adventure offline, customize your game, and challenge friends in local multiplayer.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
